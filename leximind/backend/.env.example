# ─────────────────────────────────────────────────────────────────
#  LexiMind Backend — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Gemini API ────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── CORS (comma-separated allowed origins) ────────────────────────
# For local dev:
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# For production add your Vercel URL:
# CORS_ORIGINS=http://localhost:3001,https://your-app.vercel.app

# ── Model Storage ─────────────────────────────────────────────────
# Path where .pkl files are stored (relative to backend root, or absolute)
# Files are auto-downloaded from Hugging Face if not present.
MODELS_DIR=models

# ── Upload limits ─────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
